<Window x:Class="Ekip.Desktop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="24">
        <StackPanel>
            <!-- Avatar -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                <Ellipse Width="100" Height="100"
                         Fill="{DynamicResource AccentBrushLight2}"/>
                <TextBlock Text="KU"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrushDark1}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Ellipse Style="{StaticResource StatusIndicator}"
                         Fill="{DynamicResource StatusAvailableBrush}"
                         Width="20" Height="20"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,5,5"/>
            </Grid>

            <!-- User Info -->
            <TextBlock x:Name="UserName"
                       Text="Kullanıcı Adı"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="UserTitle"
                       Text="Yazılım Geliştirici"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="UserDepartment"
                       Text="IT Departmanı"
                       FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,24"/>

            <!-- Status Selection -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{StaticResource MediumCornerRadius}"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Durum"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <RadioButton x:Name="StatusAvailable"
                                 GroupName="Status"
                                 IsChecked="True"
                                 Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12"
                                     Fill="{DynamicResource StatusAvailableBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Uygun"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="StatusBusy"
                                 GroupName="Status"
                                 Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12"
                                     Fill="{DynamicResource StatusBusyBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Meşgul"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="StatusAway"
                                 GroupName="Status"
                                 Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12"
                                     Fill="{DynamicResource StatusAwayBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Dışarıda"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="StatusOffline"
                                 GroupName="Status"
                                 Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12"
                                     Fill="{DynamicResource StatusOfflineBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Görünmez"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{StaticResource MediumCornerRadius}"
                    Padding="16"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Durum Mesajı"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource FluentTextBox}"
                             x:Name="StatusMessage"
                             Text=""/>
                </StackPanel>
            </Border>

            <!-- Logout Button -->
            <Button Content="Çıkış Yap"
                    Style="{StaticResource FluentButton}"
                    HorizontalAlignment="Stretch"
                    Click="Logout_Click"/>
        </StackPanel>
    </Grid>
</Window>
