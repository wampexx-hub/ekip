<Window x:Class="Ekip.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Ekip.Desktop.Views"
        mc:Ignorable="d"
        Title="Ekip Messenger"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Navigation Icons (using text for simplicity, can be replaced with Path data) -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="48"/>
            <!-- Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/Brand -->
                <Border Grid.Row="0" Padding="8,16,8,8">
                    <TextBlock Text="E"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Margin="0,8">
                    <!-- Chat -->
                    <RadioButton x:Name="NavChat"
                                 Style="{StaticResource SidebarNavItem}"
                                 IsChecked="True"
                                 ToolTip="Sohbetler"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>

                    <!-- Contacts -->
                    <RadioButton x:Name="NavContacts"
                                 Style="{StaticResource SidebarNavItem}"
                                 ToolTip="Kişiler"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>

                    <!-- Files -->
                    <RadioButton x:Name="NavFiles"
                                 Style="{StaticResource SidebarNavItem}"
                                 ToolTip="Dosyalar"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2" Margin="0,8,0,16">
                    <!-- Settings -->
                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource SidebarNavItem}"
                                 ToolTip="Ayarlar"
                                 Checked="NavItem_Checked">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                    </RadioButton>

                    <!-- User Profile -->
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Profil"
                            Margin="4,8,4,0"
                            Click="ProfileButton_Click">
                        <Grid>
                            <Ellipse Width="28" Height="28"
                                     Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="K"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <!-- Status indicator -->
                            <Ellipse Style="{StaticResource StatusIndicator}"
                                     Fill="{DynamicResource StatusAvailableBrush}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,-2,-2"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <!-- Contact/Conversation List -->
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400"/>
                <!-- Splitter -->
                <ColumnDefinition Width="Auto"/>
                <!-- Chat Area -->
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Conversation/Contact List Panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Padding="12">
                        <TextBox Style="{StaticResource FluentTextBox}"
                                 x:Name="SearchBox"
                                 Tag="Ara..."
                                 TextChanged="SearchBox_TextChanged"/>
                    </Border>

                    <!-- Content Frame for List Views -->
                    <Frame x:Name="ListFrame"
                           Grid.Row="1"
                           NavigationUIVisibility="Hidden"/>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          Background="{DynamicResource DividerBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"/>

            <!-- Chat/Detail View -->
            <Frame x:Name="ContentFrame"
                   Grid.Column="2"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
