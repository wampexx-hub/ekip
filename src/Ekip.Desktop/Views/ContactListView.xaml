<Page x:Class="Ekip.Desktop.Views.ContactListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12,8">
            <TextBlock Text="Kişiler"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <!-- Contact List with TreeView for groups -->
        <TreeView x:Name="ContactTree"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4">

            <!-- Favorites -->
            <TreeViewItem Header="Favoriler" IsExpanded="True">
                <TreeViewItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeViewItem.HeaderTemplate>
            </TreeViewItem>

            <!-- Departments -->
            <TreeViewItem Header="Departmanlar" IsExpanded="True">
                <TreeViewItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeViewItem.HeaderTemplate>

                <TreeViewItem Header="IT" IsExpanded="True"/>
                <TreeViewItem Header="İnsan Kaynakları"/>
                <TreeViewItem Header="Muhasebe"/>
                <TreeViewItem Header="Pazarlama"/>
            </TreeViewItem>

            <!-- All Contacts -->
            <TreeViewItem Header="Tüm Kişiler" IsExpanded="False">
                <TreeViewItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeViewItem.HeaderTemplate>
            </TreeViewItem>
        </TreeView>
    </Grid>
</Page>
